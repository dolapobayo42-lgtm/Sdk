---
# Environment variables for the telegram-bot (example)

# Telegram
TELEGRAM_BOT_TOKEN=

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=
POLL_INTERVAL_SECONDS=60

# Launch monitor
ENABLE_LAUNCH_MONITOR=true
GITHUB_ONLY_FILTER=false
IPFS_GATEWAY=https://cf-ipfs.com/ipfs/

# Early activity scorer (locked thresholds)
EARLY_WINDOW_SECONDS=120
SCORE_THRESHOLD=7

# Optional metric weights (defaults to 1)
WEIGHT_DEV_BUY=1
WEIGHT_UNIQUE_BUYERS=1
WEIGHT_TOP_CONCENTRATION=1
WEIGHT_CURVE_PROGRESS=1
WEIGHT_CREATOR_HISTORY=1

# Logging
LOG_LEVEL=info
